<?xml version="1.0"?>
<package format="3">
  <name>nav</name>
  <version>0.1.0</version>
  <description>Localization on a known map, planning and navigation for RosMaster, ROS 2 Humble.</description>
  <maintainer email="fortega@udesa.edu.ar">Grupo TP Final PRA</maintainer>
  <license>UNLICENSED</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>slam</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
